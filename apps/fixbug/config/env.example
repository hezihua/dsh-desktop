# 复制为 apps/fixbug/.env.local（勿提交 git）
# Monorepo 推荐模板见仓库根：config/infini-fixbug.env.example

CLIENT_HARNESS_ONLY=true
DSH_ENABLED=false
INTERNAL_API_TOKEN=change-me-long-random

OPENROUTER_API_KEY=
MONITOR_AI_MODEL=deepseek/deepseek-chat

# 仅当单独用浏览器打开 fixbug、且要连本机 Desktop :9100 时取消注释：
# HARNESS_URL=127.0.0.1:9100
# HARNESS_PRODUCT=server-agent
