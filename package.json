{
  "name": "dsh-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "electron:dev": "node scripts/with-electron-libs.cjs vite --config vite.config.electron.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json && vite build --config vite.config.electron.ts",
    "electron:build": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.15.5"
  }
}
